# Copy this file to .env and fill in values.

# Optional: if unset, SyncFlow AI runs in deterministic fallback mode
# (no external LLM calls) — fully functional for demo/testing.
ANTHROPIC_API_KEY=

# Model to use if an API key is provided
ANTHROPIC_MODEL=claude-sonnet-4-6

# SQLite DB path
DATABASE_URL=sqlite+aiosqlite:///./syncflow.db

# CORS origin for the frontend
FRONTEND_ORIGIN=http://localhost:3000
